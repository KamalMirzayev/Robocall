{
  "name": "@robocall/callbot-backend",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:4000": "sh -c \"pids=$(ss -lptn 'sport = :4000' 2>/dev/null | awk -F'pid=' 'NR>1 && /pid=/ {split($2,a,/[),]/); print a[1]}' | sort -u); if [ -n \"$pids\" ]; then kill $pids; fi; exec tsx watch src/index.ts\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.0",
    "express": "^4.21.2",
    "postgres": "^3.4.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.3",
    "@types/ws": "^8.5.14",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^2.0.0"
  }
}
